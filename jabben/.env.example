# Copy this file to .env.local and paste the values from:
# Firebase Console -> Project settings -> Your apps -> Web app
#
# The public Firebase web configuration identifies your project; never place
# Admin SDK credentials or service-account private keys in a React app.
# Add these same REACT_APP_* names in every Vercel deployment environment.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional (only when Google Analytics is enabled for the Firebase project)
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Public identifier used only to bootstrap the first Firestore Studio owner.
# The same email is hard-coded in firestore.rules.
REACT_APP_STUDIO_OWNER_EMAIL=owner@example.com

