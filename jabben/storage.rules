rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{userId}/{fileName} {
      // Only files referenced by published Firestore documents are linked from
      // the portfolio, but the image objects themselves must be browser-readable.
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
